{
  "name": "maira-voice-chat",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "functions"
  ],
  "scripts": {
    "test": "npm test -w functions",
    "typecheck": "npm run typecheck -w @maira/mobile && npm run typecheck -w @maira/admin",
    "build:admin": "npm run build -w @maira/admin",
    "mobile": "npm start -w @maira/mobile",
    "admin": "npm run dev -w @maira/admin",
    "test:integration": "firebase emulators:exec --project demo-maira-voice --only firestore \"node --test tests/integration.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^14.27.0"
  }
}
